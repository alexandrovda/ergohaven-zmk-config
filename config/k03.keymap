#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENC_VOL";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        behavior_hold_tap: behavior_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "BEHAVIOR_HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_retro_tap: lt_retro_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_RETRO_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            retro-tap;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                                            &kp N6  &kp N7                              &kp N8     &kp N9    &kp N0    &kp BSPC
&kp TAB         &kp Q   &kp W   &kp E         &kp R         &kp T                                             &kp Y   &kp U                               &kp I      &kp O     &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F         &kp G                                             &kp H   &kp J                               &kp K      &kp L     &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V         &kp B        &kp F5                   &kp K_MUTE  &kp N   &behavior_hold_tap RIGHT_BRACKET M  &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                        &none   &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 ENTER  &lt_retro_tap 4 SPACE    &kp ENTER   &mo 2   &kp RCTRL                           &kp RALT   &kp RGUI
            >;

            display-name = "Base";
            sensor-bindings =
                <&inc_dec_kp F10 F11>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        nav {
            bindings = <
&kp F1    &kp F2   &kp F3        &kp F4    &kp F5         &kp F6                     &kp F7           &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&kp CAPS  &kp INS  &kp DELETE    &kp UP    &kp BACKSPACE  &kp HOME                   &kp PG_UP        &kp N7  &kp N8  &kp N9   &trans   &trans
&trans    &trans   &kp LEFT      &kp DOWN  &kp RIGHT      &kp END                    &kp PG_DN        &kp N4  &kp N5  &kp N6   &trans   &trans
&trans    &trans   &kp LC(LEFT)  &trans    &kp LC(RIGHT)  &trans    &none    &trans  &kp PRINTSCREEN  &kp N1  &kp N2  &kp N3   &trans   &trans
                   &trans        &trans    &trans         &trans    &none    &trans  &mo 3            &trans  &kp N0  &trans
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
&trans  &trans    &kp AT    &kp DLLR   &kp HASH  &trans                       &trans     &trans    &kp CARET  &trans    &trans    &trans
&trans  &trans    &kp LT    &kp EQUAL  &kp GT    &kp GRAVE                    &trans     &kp LBKT  &kp UNDER  &kp RBKT  &trans    &trans
&trans  &kp BSLH  &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &trans
&trans  &trans    &kp STAR  &kp COLON  &kp FSLH  &trans     &trans    &trans  &trans     &kp PIPE  &kp TILDE  &kp AMPS  &trans    &trans
                  &trans    &trans     &trans    &mo 3      &trans    &trans  &trans     &trans    &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans       &trans  &trans  &trans  &trans  &trans                    &trans        &trans        &trans            &trans        &trans        &studio_unlock
&trans       &trans  &trans  &trans  &trans  &trans                    &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans        &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans    &trans  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans
                     &trans  &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans            &trans
            >;

            display-name = "Adjust";
        };

        useful {
            bindings = <
&trans  &trans       &kp F5          &kp F10        &kp F11        &kp LS(F9)                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans       &kp LC(N)       &kp LC(E)      &kp LC(LS(R))  &kp LA(INS)                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(F12)  &kp LA(LC(F7))  &kp LA(LC(B))  &kp LC(SPACE)  &kp RA(RET)                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(Z)    &kp LC(X)       &kp LC(C)      &kp LC(V)      &kp LG(V)    &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                     &trans          &trans         &trans         &trans       &trans    &trans  &trans  &trans  &trans  &trans
            >;

            label = "useful";
        };
    };
};
